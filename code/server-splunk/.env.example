# Splunk MCP Server (splunk/splunk-mcp-server2) — copy to upstream/python/.env
#
# Connection to YOUR pod's Splunk (runs on cclorchestrator78). Use the exposed
# FQDN + port for your pod; :8089 is Splunk's management/REST port.
SPLUNK_HOST=cclorchestrator78
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=REPLACE_ME          # Splunk admin password from your lab sheet
# SPLUNK_TOKEN=                     # optional: use instead of username/password
VERIFY_SSL=false                    # lab Splunk uses a self-signed cert

# MCP server transport — leave as SSE; fast-agent connects to http://localhost:8050/sse
TRANSPORT=sse
HOST=0.0.0.0
PORT=8050
LOG_LEVEL=INFO
