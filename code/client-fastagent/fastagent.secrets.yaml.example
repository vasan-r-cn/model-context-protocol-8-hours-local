# Copy to fastagent.secrets.yaml and fill in. fast-agent reads this file
# automatically from the working directory; it is kept separate from the config
# so the config can be shared and this file never is.
#
#   cp fastagent.secrets.yaml.example fastagent.secrets.yaml
#   chmod 600 fastagent.secrets.yaml
#
# Equivalent alternative: export OPENROUTER_API_KEY=... and skip this file.

openrouter:
  api_key: sk-or-v1-REPLACE_ME
  # base_url: https://openrouter.ai/api/v1    # only if you proxy OpenRouter
