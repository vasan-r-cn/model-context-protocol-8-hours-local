# fast-agent client env. Load into your shell before running fast-agent so the
# yaml ${...} substitutions and the --model flag both resolve:
#
#   cp .env.example .env     # then edit
#   set -a; . ./.env; set +a
#
# OPENROUTER_API_KEY stays out of the yaml (secret). OPENROUTER_MODEL drives
# every lab config's openrouter.default_model and the --model flag.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Your own MCP server (Module 3/4):
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_AUTH_TOKEN=cisco-mcp-workshop
