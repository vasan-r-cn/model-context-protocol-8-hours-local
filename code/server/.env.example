# MCP server — environment overrides. Copy to .env; run.sh sources it.
# Every value has a working default, so an empty .env also works.

# Bearer token required on every request to /mcp
MCP_AUTH_TOKEN=cisco-mcp-workshop

# Device credentials. Applied to every device in inventory.yaml.
DEVICE_USER=admin
DEVICE_PASSWORD=admin
DEVICE_SECRET=admin

# Management addresses live in inventory.yaml. To re-point one device without
# editing that shared file, set MCP_DEV_<NAME>_HOST (name uppercased,
# non-alphanumerics become underscores):
#MCP_DEV_SDCEIGHTKV24_HOST=10.3.0.1
#MCP_DEV_CISCOEXRUSNKV30_HOST=10.3.0.2

# Use a different inventory file entirely (per-seat or per-cohort)
#MCP_INVENTORY=/path/to/inventory.yaml

# Config-writing tools registered at startup: enabled | disabled
MCP_CONFIG_TOOLS_DEFAULT=enabled

# Where running-config snapshots are written
#MCP_SNAPSHOT_DIR=/home/ubuntu/cisco_mcp/snapshots
