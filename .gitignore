# Python venvs / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets and local env — .env.example files ARE tracked (different filename)
.env
*.secrets.yaml
fastagent.secrets.yaml

# Personal / local-only (contain real API keys)
my-notes/
