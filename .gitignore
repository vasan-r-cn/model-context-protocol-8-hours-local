# Lab runtime artifacts (regenerated per pod, not source)
code/server/snapshots/
code/server/changes/

# Vendored third-party clones (fetched by setup.sh, not committed)
code/server-splunk/upstream/

# Binary cruft / logs
*.deb
fast-agent-log.jsonl

# OS
.DS_Store
